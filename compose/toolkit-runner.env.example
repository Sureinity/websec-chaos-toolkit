# Example environment file for the toolkit-runner Compose service.
# Copy to compose/toolkit-runner.env and edit before running.
#
# DO NOT commit real secrets. Reference your operator secret store
# (vault, 1Password, etc.) and inject these values at run time.

# --- Auth references for example apps ---
# Bearer token used by examples/configs/sample-api/apps.yaml.
SAMPLE_API_BEARER_TOKEN=replace-me-before-running

# Generic session cookie example.
# SAMPLE_APP_SESSION_COOKIE=replace-me-before-running

# --- Runtime tuning ---
# Suppress optional update checks during scanner runs.
NUCLEI_DISABLE_UPDATE_CHECK=true

# --- Toxiproxy server location for chaos workflows ---
# When the chaos profile is active, the toolkit-runner reaches the
# Toxiproxy admin API at this URL on the shared toolkit-net network.
TOOLKIT_TOXIPROXY_URL=http://toxiproxy:8474
